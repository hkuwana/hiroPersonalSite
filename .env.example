# Newsletter (Supabase + Resend) — used by src/routes/api/subscribe/+server.ts
# Either service alone is enough; configure at least one in Vercel.

# Get these from: https://supabase.com/dashboard → Project Settings → API
# Table: subscribers (email text primary key, choice text, created_at timestamptz default now())
# with an INSERT policy for the anon role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Sender for subscriber notifications; must be on a Resend-verified domain.
RESEND_FROM=Site <site@hirokuwana.com>

# Your domain (for unsubscribe links)
PUBLIC_SITE_URL=https://hirokuwana.com
