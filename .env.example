# Newsletter: /api/subscribe. Direct contact delivery: /api/contact.
# Newsletter can use either service. Contact requires RESEND_API_KEY and RESEND_FROM.

# Get these from: https://supabase.com/dashboard → Project Settings → API
# Table: subscribers (email text primary key, choice text, created_at timestamptz default now())
# with an INSERT policy for the anon role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here

# Get this from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
# Sender for contact messages and subscriber notifications; must use a Resend-verified domain.
RESEND_FROM=Site <site@hirokuwana.com>

# Your domain (for unsubscribe links)
PUBLIC_SITE_URL=https://hirokuwana.com
