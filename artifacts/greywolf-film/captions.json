[
  {
    "start": 0.25,
    "end": 1.106,
    "text": "Hey Greywolf."
  },
  {
    "start": 1.136,
    "end": 1.993,
    "text": "We're Otterd."
  },
  {
    "start": 2.023,
    "end": 5.242,
    "text": "We build AI workflows around the tools your team already uses."
  },
  {
    "start": 5.272,
    "end": 8.787,
    "text": "We check the outputs with code, and help your team take over."
  },
  {
    "start": 8.817,
    "end": 10.56,
    "text": "Here's what that could look like."
  },
  {
    "start": 11.25,
    "end": 12.607,
    "text": "Start with research."
  },
  {
    "start": 12.637,
    "end": 15.844,
    "text": "A public filing becomes a source-linked spreadsheet."
  },
  {
    "start": 15.874,
    "end": 18.619,
    "text": "But one number covers nine months."
  },
  {
    "start": 18.649,
    "end": 20.468,
    "text": "We wanted the quarter."
  },
  {
    "start": 20.498,
    "end": 22.318,
    "text": "The check catches it."
  },
  {
    "start": 22.348,
    "end": 24.168,
    "text": "Back to the source."
  },
  {
    "start": 24.198,
    "end": 25.555,
    "text": "Now it ties."
  },
  {
    "start": 26.25,
    "end": 27.784,
    "text": "Or the back office."
  },
  {
    "start": 27.814,
    "end": 29.348,
    "text": "Two reports come in."
  },
  {
    "start": 29.378,
    "end": 30.912,
    "text": "Match the routine rows."
  },
  {
    "start": 30.942,
    "end": 33.649,
    "text": "Pull out a duplicate and a difference."
  },
  {
    "start": 33.679,
    "end": 37.559,
    "text": "Your team reviews the exceptions, with both originals right there."
  },
  {
    "start": 38.25,
    "end": 39.437,
    "text": "Or another questionnaire."
  },
  {
    "start": 39.467,
    "end": 43.494,
    "text": "Draft from approved policies, with a source for each answer."
  },
  {
    "start": 43.524,
    "end": 44.711,
    "text": "No supporting policy?"
  },
  {
    "start": 44.741,
    "end": 47.551,
    "text": "Leave it open for someone who knows."
  },
  {
    "start": 48.25,
    "end": 50.828,
    "text": "We work through the steps with you."
  },
  {
    "start": 50.858,
    "end": 54.553,
    "text": "Build it, test it, and help you run it yourselves."
  },
  {
    "start": 55.25,
    "end": 57.372,
    "text": "To try one, pick a lane."
  },
  {
    "start": 57.402,
    "end": 58.448,
    "text": "Public or routine?"
  },
  {
    "start": 58.478,
    "end": 60.241,
    "text": "Share public or sanitized examples."
  },
  {
    "start": 60.271,
    "end": 62.034,
    "text": "Internal, but not your edge?"
  },
  {
    "start": 62.064,
    "end": 64.186,
    "text": "Describe the steps; we'll use stand-ins."
  },
  {
    "start": 64.216,
    "end": 65.262,
    "text": "Your edge?"
  },
  {
    "start": 65.292,
    "end": 66.338,
    "text": "Keep it."
  },
  {
    "start": 66.368,
    "end": 69.566,
    "text": "We don't need your positions or your investment judgment."
  },
  {
    "start": 70.25,
    "end": 73.639,
    "text": "Hiro and Eric are coming on November tenth and twelfth."
  },
  {
    "start": 73.669,
    "end": 79.109,
    "text": "Send a task brief by November sixth: how often, how long, and what good looks like."
  },
  {
    "start": 79.139,
    "end": 83.553,
    "text": "We'll build a first version on public or dummy data before we arrive."
  },
  {
    "start": 84.25,
    "end": 85.647,
    "text": "Bring a task."
  },
  {
    "start": 85.677,
    "end": 87.549,
    "text": "Let's make something useful."
  }
]