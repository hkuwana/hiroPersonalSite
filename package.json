{
	"name": "hiropersonalsite",
	"version": "1.1",
	"license": "MIT",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"generate": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --silent",
		"prepare": "pnpm generate && svelte-kit sync",
		"check": "pnpm generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "pnpm generate && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write --cache --cache-location .cache/prettier src messages *.js *.ts *.json",
		"format:check": "prettier --check --cache --cache-location .cache/prettier src messages *.js *.ts *.json",
		"lint:code": "eslint --cache --cache-location .cache/eslint src *.js *.ts",
		"lint": "pnpm lint:code",
		"test:unit": "vitest run",
		"test": "pnpm check && pnpm lint && pnpm test:unit",
		"test:release": "pnpm test && pnpm build && pnpm check:hifi",
		"check:hifi": "node scripts/check-hifi-budget.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@iconify-json/circle-flags": "^1.2.10",
		"@inlang/paraglide-js": "^3.2.1",
		"@sveltejs/adapter-vercel": "^7.0.2",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/postcss": "^4.1.18",
		"@tailwindcss/vite": "^4.1.18",
		"@types/matter-js": "^0.20.2",
		"@types/node": "^26.6.6",
		"@types/three": "^0.169.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.14.0",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.6",
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"svelte": "^5.49.1",
		"svelte-check": "^4.3.5",
		"tailwindcss": "^4.1.18",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.54.0",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"packageManager": "pnpm@10.33.0",
	"type": "module",
	"dependencies": {
		"gsap": "^3.15.0",
		"matter-js": "^0.20.0",
		"three": "^0.169.0"
	}
}
